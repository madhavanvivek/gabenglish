{
  "name": "@gabenglish/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate.ts",
    "benchmark:validate": "tsx src/scripts/gabroo-speech-benchmark-cli.ts",
    "benchmark:report": "tsx src/scripts/gabroo-speech-benchmark-report-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.3.3",
    "pg": "^8.16.0",
    "zod": "^3.25.28",
    "@gabenglish/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
