NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gabenglish
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Active Gabroo speech provider for the current development phase: Google Cloud Text-to-Speech.
# Keep the API key server-side and restrict it to the Cloud Text-to-Speech API.
# Configure only after Google Cloud access, billing/quota and usage are intentionally prepared.
# GABROO_GOOGLE_TTS_API_KEY=
# GABROO_GOOGLE_TTS_LANGUAGE_CODE=ml-IN
# Optional: language tag used for English phrases inside Malayalam SSML.
# GABROO_GOOGLE_TTS_ENGLISH_LANGUAGE_CODE=en-US
# Use ssml for bilingual language tags; set text only for controlled plain-text A/B auditions.
GABROO_GOOGLE_TTS_INPUT_MODE=ssml
# Choose an explicit Standard/WaveNet voice; this does not constitute final voice approval.
# GABROO_GOOGLE_TTS_VOICE=ml-IN-Standard-B

# Alternative OpenAI-compatible speech provider; configure only one TTS provider.
# GABROO_LLM_API_KEY=
# GABROO_LLM_BASE_URL=https://api.openai.com/v1
# GABROO_TTS_MODEL=
# GABROO_TTS_VOICE=

# Set false to disable speech routes after the next API restart/deploy.
GABROO_TTS_ENABLED=true

# Provider-independent hard limits for Gabroo speech synthesis (Unicode characters).
# Defaults are conservative safeguards; tune only after validating provider pricing and product policy.
GABROO_TTS_DAILY_CHARACTER_LIMIT=10000
GABROO_TTS_MONTHLY_CHARACTER_LIMIT=100000
