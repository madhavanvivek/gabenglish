NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gabenglish
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional OpenAI-compatible Gabroo chat provider. Configure both key and model.
GABROO_API_KEY=
GABROO_API_BASE_URL=https://api.openai.com/v1
GABROO_API_MODEL=
