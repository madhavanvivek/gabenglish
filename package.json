{
  "name": "gabenglish",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @gabenglish/api dev",
    "dev:mobile": "pnpm --filter @gabenglish/mobile start -- --lan",
    "dev:mobile:android": "pnpm --filter @gabenglish/mobile android",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
